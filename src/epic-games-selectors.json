{
  "$comment": "Locators for epic-games.js. Each entry is one Playwright selector or a list of candidates that are tried together (locator.or). Epic redesigns the store a few times a year: when something breaks, usually only one entry here has to change. The claimer loads this bundled file, then overrides it with EG_SELECTORS_URL (default: this file on the main branch of the repo, so fixes reach running containers without rebuilding the image) and finally with data/epic-games-selectors.json for local hot-fixes. Only a remote file with a version >= the bundled one is applied.",
  "version": 2,
  "nav": "egs-navigation",
  "navLoggedInAttr": "isloggedin",
  "navUserAttr": "displayname",
  "privacyContinue": ["button:has-text(\"Continue\")"],
  "freeNowLinks": ["a:has(span:text-is(\"Free Now\"))"],
  "cloudflareTitle": "just a moment|one more step|attention required",
  "cloudflareText": ["text=/complete a security check|verify you are human/i"],
  "purchaseUrl": "https://store.epicgames.com/purchase?offers=1-{namespace}-{id}",
  "login": {
    "email": ["#email", "input[name=\"email\"]", "input[type=\"email\"]"],
    "continue": ["button#continue", "button[type=\"submit\"]"],
    "password": ["#password", "input[name=\"password\"]", "input[type=\"password\"]"],
    "signIn": ["button#sign-in", "button[type=\"submit\"]"],
    "confirmAccount": ["button#yes", "button[aria-label=\"Yes, continue\"]"],
    "error": ["#form-error-message"],
    "captcha": [".h_captcha_challenge iframe"],
    "captchaIncorrect": ["p:has-text(\"Incorrect response.\")"],
    "mfaUrl": "**/id/login/mfa**",
    "mfaCode": ["input[name=\"code-input-0\"]", "input[autocomplete=\"one-time-code\"]"],
    "mfaSubmit": ["button[type=\"submit\"]"]
  },
  "product": {
    "cta": ["button[data-testid=\"purchase-cta-button\"]", "button:text-matches(\"^\\\\s*(Get|In Library|Requires Base Game)\\\\s*$\", \"i\")"],
    "ctaLoading": "loading",
    "ctaInLibrary": "in library",
    "ctaRequiresBaseGame": "requires base game",
    "matureContinue": ["button:has-text(\"Continue\")"],
    "ageSelect": ["[data-testid=\"AgeSelect\"]"],
    "ageMonth": "#month_toggle", "ageMonthItem": "#month_menu li:has-text(\"01\")",
    "ageDay": "#day_toggle", "ageDayItem": "#day_menu li:has-text(\"01\")",
    "ageYear": "#year_toggle", "ageYearItem": "#year_menu li:has-text(\"1987\")",
    "bundleMarker": ["span:text-is(\"About Bundle\")"],
    "bundleTitle": ["span:has-text(\"Buy\"):left-of([data-testid=\"purchase-cta-button\"])"],
    "bundleIncludes": [".product-card-top-row h5"],
    "title": ["h1"],
    "baseGameLink": ["a:has-text(\"Overview\")"],
    "deviceContinue": ["button:has-text(\"Continue\")"],
    "buyAnyway": ["button:has-text(\"Yes, buy now\")"],
    "eulaText": [":has-text(\"end user license agreement\")"],
    "eulaAgree": ["input#agree"],
    "eulaAccept": ["button:has-text(\"Accept\")"]
  },
  "checkout": {
    "iframe": ["#webPurchaseContainer iframe"],
    "regionError": [":has-text(\"unavailable in your region\")"],
    "pin": [".payment-pin-code"],
    "pinInput": ["input.payment-pin-code__input"],
    "pinContinue": ["button:has-text(\"Continue\")"],
    "placeOrder": ["button:text-matches(\"Add to library|Place Order\", \"i\"):not(:has(.payment-loading--loading))"],
    "accept": ["button:has-text(\"I Accept\")", "button:has-text(\"I Agree\")"],
    "captcha": ["#h_captcha_challenge_checkout_free_prod iframe", "iframe[src*=\"hcaptcha.com\"]"],
    "captchaFailed": [".payment__errors:has-text(\"Failed to challenge captcha\")"],
    "success": ["text=Thanks for your order!", "text=It's all yours", "text=Download the Epic Games Launcher to play", "text=Is Epic Games Launcher installed?"],
    "alreadyOwned": ["text=/already (own|in your library)/i"]
  }
}
